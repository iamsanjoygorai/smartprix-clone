generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String?
  role         String  @default("USER")

  reviews     Review[]
  comparisons Comparison[]
  favorites   Favorite[]
  priceAlerts PriceAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ─────────────────────────────────────────────
// BRANDS
// ─────────────────────────────────────────────

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logoUrl     String?
  description String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  description      String?
  shortDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  releaseDate DateTime?
  isActive    Boolean   @default(true)

  variants       ProductVariant[]
  images         ProductImage[]
  specifications ProductSpecification[]
  prices         Price[]
  reviews        Review[]
  favorites      Favorite[]
  priceAlerts    PriceAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// PRODUCT VARIANTS
// ─────────────────────────────────────────────

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name    String
  sku     String? @unique
  color   String?
  storage String?
  ram     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices Price[]

  @@index([productId])
}

// ─────────────────────────────────────────────
// PRODUCT IMAGES
// ─────────────────────────────────────────────

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
}

// ─────────────────────────────────────────────
// SPECIFICATIONS
// ─────────────────────────────────────────────

model Specification {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  unit     String?
  dataType String  @default("text")

  values   SpecificationValue[]
  products ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecificationValue {
  id              String        @id @default(cuid())
  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  value String

  products ProductSpecification[]

  createdAt DateTime @default(now())

  @@index([specificationId])
}

// ─────────────────────────────────────────────
// PRODUCT ↔ SPECIFICATION
// ─────────────────────────────────────────────

model ProductSpecification {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  valueId String?
  value   SpecificationValue? @relation(fields: [valueId], references: [id])

  customValue String?

  createdAt DateTime @default(now())

  @@unique([productId, specificationId])
  @@index([specificationId])
}

// ─────────────────────────────────────────────
// SELLERS
// ─────────────────────────────────────────────

model Seller {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  websiteUrl String?
  logoUrl    String?
  isActive   Boolean @default(true)

  prices Price[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PRICES
// ─────────────────────────────────────────────

model Price {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id])

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  productUrl String?
  inStock    Boolean @default(true)

  recordedAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([sellerId])
  @@index([recordedAt])
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  title   String?
  content String?

  isVerified  Boolean @default(false)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// COMPARISONS
// ─────────────────────────────────────────────

model Comparison {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String?

  products ComparisonProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComparisonProduct {
  id String @id @default(cuid())

  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  productId String

  @@unique([comparisonId, productId])
}

// ─────────────────────────────────────────────
// FAVORITES
// ─────────────────────────────────────────────

model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────
// PRICE ALERTS
// ─────────────────────────────────────────────

model PriceAlert {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  targetPrice Decimal   @db.Decimal(12, 2)
  isActive    Boolean   @default(true)
  triggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// NEWS
// ─────────────────────────────────────────────

model News {
  id String @id @default(cuid())

  title         String
  slug          String  @unique
  authorName    String
  featuredImage String?

  status      String    @default("DRAFT")
  publishedAt DateTime?

  allowLikes    Boolean @default(true)
  allowComments Boolean @default(true)
  allowSharing  Boolean @default(true)

  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  blocks     NewsBlock[]
  categories NewsCategoryPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// NEWS CONTENT BLOCKS
// ─────────────────────────────────────────────

model NewsBlock {
  id String @id @default(cuid())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  type     String
  position Int
  content  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsId])
  @@index([newsId, position])
}

model NewsCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  parentId String?

  parent   NewsCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NewsCategory[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts NewsCategoryPost[]

  @@index([name])
  @@index([createdAt])
  @@index([parentId])
}


model NewsCategoryPost {
  newsId     String
  categoryId String

  news     News         @relation(fields: [newsId], references: [id], onDelete: Cascade)
  category NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([newsId, categoryId])
  @@index([categoryId])
}
