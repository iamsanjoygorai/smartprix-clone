generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String? @unique
  mobile       String? @unique
  name         String?
  passwordHash String?
  role         String  @default("USER")

  // Account status
  isDisabled Boolean @default(false)

  // Soft deletion
  // User row is NEVER physically deleted.
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletionReason String?

  analyticsEvents AnalyticsEvent[]

  dateOfBirth     DateTime?
  gender          String?
  profileImageUrl String?

  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  passwordResetCodeHash      String?
  passwordResetCodeExpiresAt DateTime?
  passwordResetCodeAttempts  Int       @default(0)
  passwordResetCodeSentAt    DateTime?
  passwordResetOtpSessionId  String?

  reviews     Review[]
  comparisons Comparison[]
  favorites   Favorite[]
  priceAlerts PriceAlert[]

  userRoles       UserRole[]
  userPermissions UserPermission[]

  // Audit history
  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")

  // Git-like history
  historyEventsAsActor  HistoryEvent[] @relation("HistoryActor")
  historyEventsAsTarget HistoryEvent[] @relation("HistoryTarget")

  historySnapshotsCreated HistorySnapshot[] @relation("HistorySnapshotCreator")

  // Sessions
  sessions UserSession[]

  // Search history
  searchHistory SearchHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([isDeleted, createdAt])
  @@index([role])

authoredArticles Article[] @relation("ArticleAuthor")
authoredNews     News[]    @relation("NewsAuthor")
authoredPages    Page[]    @relation("PageAuthor")

uploadedMedia Media[] @relation("MediaUploader")

articleRevisions ArticleRevision[] @relation("ArticleRevisionEditor")
newsRevisions    NewsRevision[]    @relation("NewsRevisionEditor")
pageRevisions    PageRevision[]    @relation("PageRevisionEditor")

createdRedirects Redirect[] @relation("RedirectCreator")

}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userPermissions UserPermission[]
}

model UserRole {
  id String @id @default(cuid())

  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
}

model AuditLog {
  id String @id @default(cuid())

  actorUserId  String?
  targetUserId String?

  action   String
  category String @default("SYSTEM")

  entityType String?
  entityId   String?

  description String?
  metadata    Json?

  sessionId String?

  ipAddress String?
  userAgent String?

  country  String?
  state    String?
  city     String?
  timezone String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([category])
  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

// ─────────────────────────────────────────────
// GIT-LIKE HISTORY
// ─────────────────────────────────────────────
//
// HistoryEvent is immutable.
// It records what happened, who did it, what entity
// was affected, and optionally what changed.
//
// IMPORTANT:
// - Never update HistoryEvent.
// - Never delete HistoryEvent.
// - Do not store passwords, tokens, OTPs or secrets.
// - "changes" contains before/after values.
// ─────────────────────────────────────────────

model HistoryEvent {
  id String @id @default(cuid())

  actorUserId  String?
  targetUserId String?

  category  String
  eventType String
  operation String?

  entityType String?
  entityId   String?

  title       String
  description String?

  version Int?

  changes  Json?
  metadata Json?

  sessionId String?

  ipAddress String?
  userAgent String?

  country  String?
  state    String?
  city     String?
  timezone String?

  parentEventId String?

  createdAt DateTime @default(now())

  actor User? @relation("HistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  targetUser User? @relation("HistoryTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  parentEvent HistoryEvent? @relation("HistoryEventTree", fields: [parentEventId], references: [id], onDelete: SetNull)

  childEvents HistoryEvent[] @relation("HistoryEventTree")

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([entityType, entityId, version])
  @@index([eventType, createdAt])
  @@index([category, createdAt])
  @@index([sessionId, createdAt])
  @@index([parentEventId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// HISTORY SNAPSHOTS
// ─────────────────────────────────────────────
//
// Snapshots allow us to reconstruct the state of
// important entities.
//
// We DON'T create a full snapshot for every event.
//
// Example:
//
// Product
// v1 → full snapshot
// v2 → changes
// v3 → changes
// v10 → full snapshot
//
// This keeps storage manageable.
// ─────────────────────────────────────────────

model HistorySnapshot {
  id String @id @default(cuid())

  entityType String
  entityId   String

  version Int

  data Json

  eventId String?

  createdByUserId String?

  checksum String?

  createdAt DateTime @default(now())

  createdBy User? @relation("HistorySnapshotCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@index([entityType, entityId, version])
  @@index([createdByUserId, createdAt])
  @@index([eventId])
}

model UserSession {
  id String @id @default(cuid())

  userId String

  startedAt  DateTime  @default(now())
  lastSeenAt DateTime?
  endedAt    DateTime?

  isActive Boolean @default(true)

  deviceType      String?
  browser         String?
  operatingSystem String?

  ipAddress String?
  userAgent String?

  country  String?
  state    String?
  city     String?
  timezone String?

  analyticsEvents AnalyticsEvent[]

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  auditLogs     AuditLog[]
  searchHistory SearchHistory[]
  historyEvents HistoryEvent[]

  @@index([userId])
  @@index([userId, startedAt])
  @@index([isActive])
  @@index([startedAt])
  @@index([endedAt])
}

model SearchHistory {
  id String @id @default(cuid())

  userId    String?
  sessionId String?

  query      String
  normalized String

  filters Json?

  ipAddress String?
  userAgent String?

  country  String?
  state    String?
  city     String?
  timezone String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([normalized])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model SearchQuery {
  id             String   @id @default(cuid())
  query          String
  normalized     String
  count          Int      @default(1)
  lastSearchedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([normalized])
  @@index([count])
  @@index([lastSearchedAt])
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  specificationSchemas SpecificationSchema[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ─────────────────────────────────────────────
// BRANDS
// ─────────────────────────────────────────────

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logoUrl     String?
  description String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  description      String?
  shortDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  releaseDate DateTime?
  isActive    Boolean   @default(true)

  variants       ProductVariant[]
  images         ProductImage[]
  specifications ProductSpecification[]
  prices         Price[]
  reviews        Review[]
  favorites      Favorite[]
  priceAlerts    PriceAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// PRODUCT VARIANTS
// ─────────────────────────────────────────────

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name    String
  sku     String? @unique
  color   String?
  storage String?
  ram     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices Price[]

  @@index([productId])
}

// ─────────────────────────────────────────────
// PRODUCT IMAGES
// ─────────────────────────────────────────────

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
}

// ─────────────────────────────────────────────
// SPECIFICATIONS
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// SPECIFICATIONS
// ─────────────────────────────────────────────

model Specification {
  id   String @id @default(cuid())
  name String
  slug String @unique

  unit     String?
  dataType String  @default("text")

  // Full Specs organization
  // Examples: General, Design, Display, Camera, Battery
  group String @default("General")

  // LEFT / RIGHT column on Full Specs page
  column String @default("LEFT")

  // Controls section ordering
  groupOrder Int @default(0)

  // Controls specification ordering inside a group
  sortOrder Int @default(0)

  values   SpecificationValue[]
  products ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([column])
  @@index([groupOrder])
  @@index([sortOrder])
}

model SpecificationValue {
  id              String        @id @default(cuid())
  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  value String

  products ProductSpecification[]

  createdAt DateTime @default(now())

  @@index([specificationId])
}

// ─────────────────────────────────────────────
// PRODUCT ↔ SPECIFICATION
// ─────────────────────────────────────────────

model ProductSpecification {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Existing specification system
  specificationId String?
  specification   Specification? @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  valueId String?
  value   SpecificationValue? @relation(fields: [valueId], references: [id])

  customValue String?

  // New schema-driven specification system
  definitionId String?
  definition   SpecificationDefinition? @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  valueText    String?
  valueNumber  Decimal?  @db.Decimal(20, 6)
  valueBoolean Boolean?
  valueDate    DateTime?
  valueJson    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, specificationId])
  @@unique([productId, definitionId])
  @@index([specificationId])
  @@index([definitionId])
  @@index([definitionId, valueNumber])
  @@index([definitionId, valueBoolean])
}

// ─────────────────────────────────────────────
// SELLERS
// ─────────────────────────────────────────────

model Seller {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  websiteUrl String?
  logoUrl    String?
  isActive   Boolean @default(true)

  prices Price[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PRICES
// ─────────────────────────────────────────────

model Price {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id])

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  productUrl String?
  inStock    Boolean @default(true)

  recordedAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([sellerId])
  @@index([recordedAt])
}

model PriceAlert {
  id String @id @default(cuid())

  userId    String
  productId String

  targetPrice Decimal @db.Decimal(12, 2)
  currency    String  @default("INR")

  isActive Boolean @default(true)

  triggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([productId, isActive])
  @@index([userId, isActive])
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int
  title   String?
  content String?

  isVerified  Boolean @default(false)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// COMPARISONS
// ─────────────────────────────────────────────

model Comparison {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String?

  products ComparisonProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComparisonProduct {
  id String @id @default(cuid())

  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  productId String

  @@unique([comparisonId, productId])
}

// ─────────────────────────────────────────────
// FAVORITES
// ─────────────────────────────────────────────

model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────
// NEWS
// ─────────────────────────────────────────────

model News {
  id String @id @default(cuid())

  title String
  slug  String @unique

  excerpt String?

  // Structured CMS content
  contentJson Json?

  status ContentStatus @default(DRAFT)

  // Legacy compatibility
  authorName String

  authorId String?
  author   User? @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  // New CMS taxonomy
  categoryId String?
  category   ContentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  featuredImage String?

  featuredMediaId String?
  featuredMedia   Media? @relation("NewsFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)

  // Existing legacy block system
  blocks     NewsBlock[]
  categories NewsCategoryPost[]

  // CMS relationships
  tags     NewsTag[]
  products NewsProduct[]

  revisions NewsRevision[]

  // SEO
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  robots         String?
  ogTitle        String?
  ogDescription  String?

  ogImageId String?
  ogImage   Media? @relation("NewsOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  scheduledAt DateTime?
  archivedAt  DateTime?

  allowLikes    Boolean @default(true)
  allowComments Boolean @default(true)
  allowSharing  Boolean @default(true)

  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([createdAt])
}

model Media {
  id String @id @default(cuid())

  filename     String
  originalName String

  mimeType String
  size     Int

  width  Int?
  height Int?

  url String

  altText String?
  caption String?
  folder  String?

  uploadedById String
  uploadedBy   User @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  articleFeatured Article[] @relation("ArticleFeaturedMedia")
  articleOg       Article[] @relation("ArticleOgImage")

  newsFeatured News[] @relation("NewsFeaturedMedia")
  newsOg       News[] @relation("NewsOgImage")

  pageFeatured Page[] @relation("PageFeaturedMedia")
  pageOg       Page[] @relation("PageOgImage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([mimeType])
  @@index([folder])
  @@index([createdAt])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model NewsTag {
  newsId String
  tagId  String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag  ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([tagId])
}

model ArticleProduct {
  articleId String
  productId String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
  @@index([productId])
}

model NewsProduct {
  newsId    String
  productId String

  news    News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([newsId, productId])
  @@index([productId])
}

model ArticleRevision {
  id String @id @default(cuid())

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  version Int

  title       String
  excerpt     String?
  contentJson Json
  status      ContentStatus

  editedById String
  editedBy   User @relation("ArticleRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  changeSummary String?

  createdAt DateTime @default(now())

  @@unique([articleId, version])
  @@index([articleId, createdAt])
}

model NewsRevision {
  id String @id @default(cuid())

  newsId String
  news   News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  version Int

  title       String
  excerpt     String?
  contentJson Json
  status      ContentStatus

  editedById String
  editedBy   User @relation("NewsRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  changeSummary String?

  createdAt DateTime @default(now())

  @@unique([newsId, version])
  @@index([newsId, createdAt])
}

model PageRevision {
  id String @id @default(cuid())

  pageId String
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  version Int

  title       String
  contentJson Json
  status      ContentStatus

  editedById String
  editedBy   User @relation("PageRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  changeSummary String?

  createdAt DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model Redirect {
  id String @id @default(cuid())

  fromPath String @unique
  toPath   String

  statusCode Int @default(301)

  isActive Boolean @default(true)

  createdById String?
  createdBy   User? @relation("RedirectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toPath])
  @@index([isActive])
}

model ContentCategory {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String?

  parentId String?

  parent   ContentCategory?  @relation("ContentCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ContentCategory[] @relation("ContentCategoryHierarchy")

  articles Article[]
  news     News[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([parentId])
}

model ContentTag {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String?

  articles ArticleTag[]
  news     NewsTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ─────────────────────────────────────────────
// NEWS CONTENT BLOCKS
// ─────────────────────────────────────────────

model NewsBlock {
  id String @id @default(cuid())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  type     String
  position Int
  content  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsId])
  @@index([newsId, position])
}

model NewsCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  parentId String?

  parent   NewsCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NewsCategory[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts NewsCategoryPost[]

  @@index([name])
  @@index([createdAt])
  @@index([parentId])
}

model NewsCategoryPost {
  newsId     String
  categoryId String

  news     News         @relation(fields: [newsId], references: [id], onDelete: Cascade)
  category NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([newsId, categoryId])
  @@index([categoryId])
}

model SiteSettings {
  id              String  @id @default(cuid())
  siteName        String  @default("Smartprix Clone")
  siteDescription String  @default("Smartprix Clone Website")
  maintenanceMode Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  allowed      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model AnalyticsEvent {
  id String @id @default(cuid())

  eventType String

  userId    String?
  sessionId String?

  entityType String?
  entityId   String?

  path     String?
  referrer String?

  metadata Json?

  deviceType      String?
  browser         String?
  operatingSystem String?

  ipAddress String?

  country  String?
  state    String?
  city     String?
  timezone String?

  createdAt DateTime @default(now())

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// CMS SPECIFICATION ENGINE
// ─────────────────────────────────────────────

model SpecificationSchema {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  version Int @default(1)

  isActive Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  groups SpecificationGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model SpecificationGroup {
  id String @id @default(cuid())

  schemaId String
  schema   SpecificationSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?

  sortOrder Int @default(0)

  definitions SpecificationDefinition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schemaId, slug])
  @@index([schemaId, sortOrder])
}

model SpecificationDefinition {
  id String @id @default(cuid())

  groupId String
  group   SpecificationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name String
  slug String

  dataType String  @default("TEXT")
  unit     String?

  isRequired   Boolean @default(false)
  isFilterable Boolean @default(false)
  isComparable Boolean @default(false)
  isSearchable Boolean @default(false)

  sortOrder Int @default(0)

  configuration Json?

  options SpecificationOption[]

  productSpecifications ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, slug])
  @@index([groupId, sortOrder])
  @@index([dataType])
  @@index([isFilterable])
  @@index([isComparable])
  @@index([isSearchable])
}

model SpecificationOption {
  id String @id @default(cuid())

  definitionId String
  definition   SpecificationDefinition? @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  label String
  value String

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([definitionId, value])
  @@index([definitionId, sortOrder])
}

// ─────────────────────────────────────────────
// ARTICLE REVISIONS
// ─────────────────────────────────────────────

model ArticleRevision {
  id String @id @default(cuid())

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  version Int

  title   String
  excerpt String?
  contentJson Json

  status ContentStatus

  editedById String
  editedBy   User @relation("ArticleRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  changeSummary String?

  createdAt DateTime @default(now())

  @@unique([articleId, version])
  @@index([articleId, createdAt])
  @@index([editedById])
}

model Article {
  id String @id @default(cuid())

  title String
  slug  String @unique

  excerpt String?

  contentJson Json

  status ContentStatus @default(DRAFT)

  authorId String
  author   User @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  categoryId String?
  category   ContentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  featuredMediaId String?
  featuredMedia   Media? @relation("ArticleFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)

  tags     ArticleTag[]
  products ArticleProduct[]

  revisions ArticleRevision[]

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  robots         String?
  ogTitle        String?
  ogDescription  String?

  ogImageId String?
  ogImage   Media? @relation("ArticleOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  scheduledAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([scheduledAt])
}

model Page {
  id String @id @default(cuid())

  title String
  slug  String @unique

  contentJson Json

  status ContentStatus @default(DRAFT)

  authorId String
  author   User @relation("PageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  featuredMediaId String?
  featuredMedia   Media? @relation("PageFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)

  revisions PageRevision[]

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  robots         String?
  ogTitle        String?
  ogDescription  String?

  ogImageId String?
  ogImage   Media? @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  scheduledAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([scheduledAt])
}

// ─────────────────────────────────────────────
// NEWS REVISIONS
// ─────────────────────────────────────────────

model NewsRevision {
  id String @id @default(cuid())

  newsId String
  news   News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  version Int

  title   String
  excerpt String?
  contentJson Json

  status ContentStatus

  editedById String
  editedBy   User @relation("NewsRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  changeSummary String?

  createdAt DateTime @default(now())

  @@unique([newsId, version])
  @@index([newsId, createdAt])
  @@index([editedById])
}

// ─────────────────────────────────────────────
// PAGE REVISIONS
// ─────────────────────────────────────────────

model PageRevision {
  id String @id @default(cuid())

  pageId String
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  version Int

  title String
  contentJson Json

  status ContentStatus

  editedById String
  editedBy   User @relation("PageRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  changeSummary String?

  createdAt DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, createdAt])
  @@index([editedById])
}

// ─────────────────────────────────────────────
// CMS REDIRECTS
// ─────────────────────────────────────────────

model Redirect {
  id String @id @default(cuid())

  fromPath String @unique
  toPath   String

  statusCode Int @default(301)
  isActive   Boolean @default(true)

  createdById String?
  createdBy   User? @relation("RedirectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([toPath])
}


model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  description      String?
  shortDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  releaseDate DateTime?
  isActive    Boolean   @default(true)

  variants       ProductVariant[]
  images         ProductImage[]
  specifications ProductSpecification[]
  prices         Price[]
  reviews        Review[]
  favorites      Favorite[]
  priceAlerts    PriceAlert[]

  // CMS references
  articleReferences ArticleProduct[]
  newsReferences    NewsProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}